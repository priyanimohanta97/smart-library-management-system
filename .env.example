# ==============================================================================
# Athenaeum Smart Library Book Recommendation & Management System
# Sanitized Environment Configuration Template (.env.example)
# ==============================================================================
#
# IMPORTANT SECURITY NOTICE:
# - Do NOT commit actual secrets, passwords, or tokens to version control.
# - Copy this file to '.env' for local development or input these key-value pairs
#   directly into your cloud hosting dashboard (Render / Vercel).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER CONFIGURATION (Render / Spring Boot)
# ------------------------------------------------------------------------------
# Injected dynamically by Render Web Services (default fallback: 8080)
PORT=8080

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (MongoDB Atlas / Cloud MongoDB)
# ------------------------------------------------------------------------------
# MongoDB connection URI (e.g., MongoDB Atlas SRV connection string)
# Replace <dbuser>, <dbpassword>, and <cluster-url> with values from MongoDB Atlas.
# Supported variable names: SPRING_DATA_MONGODB_URI (project primary) or MONGODB_URI
#
# MongoDB Atlas Production Example:
# SPRING_DATA_MONGODB_URI=mongodb+srv://<dbuser>:<dbpassword>@cluster0.xxxxx.mongodb.net/smart_library_db?retryWrites=true&w=majority
#
# Local Development Fallback:
SPRING_DATA_MONGODB_URI=mongodb://localhost:27017/smart_library_db

# ------------------------------------------------------------------------------
# 3. JWT SECURITY CONFIGURATION
# ------------------------------------------------------------------------------
# MANDATORY: Must be a cryptographically secure random key of at least 256 bits (32 bytes / 64 hex characters).
# You can generate a 64-hex key in PowerShell/Bash using:
#   openssl rand -hex 32
# If unset or shorter than 32 bytes, the Spring Boot backend will abort on startup.
JWT_SECRET=your_secure_256_bit_random_hex_key_here_minimum_32_bytes_length
JWT_EXPIRATION_MS=86400000

# ------------------------------------------------------------------------------
# 4. INITIAL ADMINISTRATOR ACCOUNT BOOTSTRAP
# ------------------------------------------------------------------------------
# Created automatically on initial application boot if the email does not already exist.
# Password must be at least 8 characters.
# Leave ADMIN_EMAIL and ADMIN_PASSWORD empty if you prefer manual account creation.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_secure_admin_password_here
ADMIN_NAME=Library Administrator

# ------------------------------------------------------------------------------
# 5. CENTRALIZED CIRCULATION BORROWING POLICY
# ------------------------------------------------------------------------------
BORROWING_MAX_ACTIVE_LOANS=4
BORROWING_LOAN_DURATION_DAYS=14
BORROWING_OVERDUE_GRACE_DAYS=0

# ------------------------------------------------------------------------------
# 6. CROSS-ORIGIN RESOURCE SHARING (CORS) - FRONTEND ORIGINS
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins (NO trailing slashes).
# In production on Render, set this to your Vercel deployment URL.
# Wildcard '*' is strictly rejected by Spring Security because credentials are enabled.
#
# Production Example on Render:
# CORS_ALLOWED_ORIGINS=https://your-library-app.vercel.app,http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# 7. STARTER BOOK DATASET INITIALIZATION
# ------------------------------------------------------------------------------
# Imports the curated 104-book starter dataset on first startup from CSV classpath
BOOK_DATASET_IMPORT_ENABLED=true
BOOK_DATASET_RESOURCE_PATH=data/books-dataset.csv
BOOK_DATASET_FALLBACK_RESOURCE_PATH=data/library_real_books_starter_dataset.csv
BOOK_DATASET_DEFAULT_COPIES=3
BOOK_DATASET_IMPORT_FORCE=false

# ------------------------------------------------------------------------------
# 8. FRONTEND CONFIGURATION (Vercel / Client)
# ------------------------------------------------------------------------------
# Set this in your Vercel Project Environment Variables to connect to Render backend.
# In local development, leave it unset to use the local Vite proxy.
#
# Vercel Production Setting:
# VITE_API_BASE_URL=https://your-backend-service.onrender.com
